                        "key": "token",
                        "label": "OIDC ID Token",
                        "type": "text",
                        "bindable": true,
                        "required": true,
                        "placeholder": "Enter a token",
                        "help": {
                            "text": "Use the ID token issued by the selected provider. Its iss claim must match the provider."
                        }
                    },
                    {
                        "key": "provider",
                        "label": "Provider",
                        "type": "choice",
                        "bindable": true,
                        "required": true,
                        "placeholder": "Select a provider",
                        "choices": [
                            {
                                "label": "Apple",
                                "value": "apple"
                            },
                            {
                                "label": "Azure",
                                "value": "azure"
                            },
                            {
                                "label": "Facebook",
                                "value": "facebook"
                            },
                            {
                                "label": "Google",
                                "value": "google"
                            },
                            {
                                "label": "Keycloak (deprecated)",
                                "value": "keycloak"
                            }
                        ],
                        "help": {
                            "text": "Use the provider name or the issuer that Supabase uses to verify the ID token."
                        }
                    },
                    {
                        "key": "accessToken",
                        "label": "Access Token",
                        "type": "text",
                        "bindable": true,
                        "placeholder": "Enter an access_token",
                        "legacyKey": "access_token",
                        "help": {
                            "text": "When the ID token contains an at_hash claim, supply the access token received with it."
                        }
                    },
                    {
                        "key": "nonce",
                        "label": "Nonce",
                        "type": "text",
                        "bindable": true,
                        "placeholder": "Enter a nonce",
                        "help": {
                            "text": "When the ID token contains a nonce claim, supply the nonce used to obtain the token."
                        }
                    },
                    {
                        "key": "captchaToken",
                        "label": "Captcha Token",
                        "type": "text",
                        "bindable": true,
                        "placeholder": "Enter a captcha token",
                        "help": {
                            "text": "Use the verification token returned when the user completes the captcha."
                        }
                    }
                ]
            },
            "validation": {
                "requireAny": [
                    [
                        "provider"
                    ],
                    [
                        "token"
                    ]
                ]
            }
