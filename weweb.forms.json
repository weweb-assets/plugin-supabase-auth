                                    "type": "choice",
                                    "choices": [
                                        {
                                            "label": "Name",
                                            "value": "name"
                                        },
                                        {
                                            "label": "Picture",
                                            "value": "picture"
                                        },
                                        {
                                            "label": "Given name",
                                            "value": "given_name"
                                        },
                                        {
                                            "label": "Family name",
                                            "value": "family_name"
                                        },
                                        {
                                            "label": "Middle name",
                                            "value": "middle_name"
                                        },
                                        {
                                            "label": "Nickname",
                                            "value": "nickname"
                                        },
                                        {
                                            "label": "Profile URL",
                                            "value": "profile"
                                        },
                                        {
                                            "label": "Website URL",
                                            "value": "website"
                                        },
                                        {
                                            "label": "Gender",
                                            "value": "gender"
                                        },
                                        {
                                            "label": "Birthdate",
                                            "value": "birthdate"
                                        },
                                        {
                                            "label": "Zoneinfo",
                                            "value": "zoneinfo"
                                        },
                                        {
                                            "label": "Locale",
                                            "value": "locale"
                                        },
                                        {
                                            "label": "Address",
                                            "value": "address"
                                        }
                                    ]
                                },
                                {
                                    "key": "value",
                                    "label": "Value",
                                    "type": "text",
                                    "bindable": true
                                }
                            ]
                        }
                    },
                    {
                        "key": "captchaToken",
                        "label": "Captcha Token",
                        "type": "text",
                        "bindable": true,
                        "placeholder": "Enter a captcha token",
                        "help": {
                            "text": "Use the verification token returned when the user completes the captcha."
                        }
                    }
                ]
            },
            "validation": {
                "requireAny": [
                    [
                        "email",
                        "phone"
                    ],
                    [
                        "password"
                    ]
                ]
            }
        },
