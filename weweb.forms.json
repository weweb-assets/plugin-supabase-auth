        {
            "name": "isAuthenticated",
            "type": "boolean"
        }
    ],
    "actions": [
        {
            "name": "Sign Up",
            "code": "signUp",
            "isAsync": true,
            "form": {
                "fields": [
                    {
                        "key": "type",
                        "label": "Type",
                        "type": "choice",
                        "choices": [
                            {
                                "label": "Email",
                                "value": "email"
                            },
                            {
                                "label": "Phone",
                                "value": "phone"
                            }
                        ],
                        "displayDefault": "email"
                    },
                    {
                        "key": "email",
                        "label": "Email",
                        "type": "text",
                        "bindable": true,
                        "required": true,
                        "placeholder": "Enter an email",
                        "visibleWhen": {
                            "field": "type",
                            "equals": "email"
                        },
                        "help": {
                            "text": "Open the isolated preview in a separate tab to test an email confirmation or sign-in link."
                        }
                    },
                    {
                        "key": "phone",
                        "label": "Phone",
                        "type": "text",
                        "bindable": true,
                        "required": true,
                        "placeholder": "Enter a phone number",
                        "visibleWhen": {
                            "field": "type",
                            "equals": "phone"
                        }
                    },
                    {
                        "key": "password",
                        "label": "Password",
                        "type": "text",
                        "bindable": true,
                        "required": true,
                        "placeholder": "Enter a password"
                    },
                    {
                        "key": "redirectPage",
                        "label": "Email redirect to",
                        "type": "choice",
                        "bindable": true,
                        "placeholder": "Select a page",
                        "operation": "project.pages",
                        "pageFilter": "static",
                        "visibleWhen": {
                            "field": "type",
                            "equals": "email"
                        }
                    },
                    {
                        "key": "channel",
                        "label": "Channel",
                        "type": "choice",
                        "bindable": true,
                        "placeholder": "Select a channel",
                        "choices": [
                            {
                                "label": "Whatsapp",
                                "value": "whatsapp"
                            },
                            {
                                "label": "SMS",
                                "value": "sms"
                            }
                        ],
                        "visibleWhen": {
                            "field": "type",
                            "equals": "phone"
                        },
                        "help": {
                            "text": "WhatsApp sign-in requires WhatsApp configuration with your Supabase SMS provider."
                        }
                    },
                    {
                        "key": "metadata",
                        "label": "Metadata",
                        "type": "list",
                        "bindable": true,
                        "item": {
                            "type": "record",
                            "fields": [
                                {
                                    "key": "key",
